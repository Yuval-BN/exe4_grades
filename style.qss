QMainWindow,
QWidget {
    background-color: #f4f6f8;
    color: #263238;
}

QPushButton {
    background-color: #1976d2;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
}

QPushButton:hover {
    background-color: #1565c0;
}

QPushButton:pressed {
    background-color: #0d47a1;
}

QLineEdit {
    background-color: white;
    border: 1px solid #b0bec5;
    border-radius: 4px;
    padding: 6px;
}

QTableWidget {
    background-color: white;
    alternate-background-color: #eef3f7;
    gridline-color: #cfd8dc;
    border: 1px solid #b0bec5;
}

QHeaderView::section {
    background-color: #37474f;
    color: white;
    padding: 6px;
    border: none;
    border-right: 1px solid #546e7a;
}

QDialog {
    background-color: #f4f6f8;
}
